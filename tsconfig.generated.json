{
  // Compiles the generated Prisma client.
  //
  // Prisma's `prisma-client` generator emits plain TypeScript into the source
  // tree. It is regenerated by `npm run db:generate` and is intentionally not
  // type-checked or linted by the application config, but it must still be
  // compiled so the runtime (and its imports) resolve with plain Node.js.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "rootDir": "src/generated",
    "outDir": "dist/generated",

    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationDir": "dist/generated",
    "sourceMap": false,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.generated.tsbuildinfo"
  },
  "include": ["src/generated/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
