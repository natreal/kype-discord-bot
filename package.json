{
  "name": "discord-bot-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation of a modular, production-quality Discord bot platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#/*": "./dist/*"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "npm run db:generate && tsc --build && node scripts/write-build-info.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "deploy:commands": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts",
    "db:smoke": "tsx --env-file-if-exists=.env scripts/db-smoke.ts",
    "setup:resource-smoke": "tsx --env-file-if-exists=.env scripts/setup-resource-smoke.ts --cleanup",
    "setup:plan": "tsx --env-file-if-exists=.env scripts/setup.ts plan",
    "setup:run": "tsx --env-file-if-exists=.env scripts/setup.ts run",
    "deploy:guilds": "tsx --env-file-if-exists=.env scripts/setup.ts deploy",
    "deploy:missing": "tsx --env-file-if-exists=.env scripts/setup.ts deploy --missing",
    "deploy:clear-guilds": "tsx --env-file-if-exists=.env scripts/clear-guild-commands.ts",
    "whoami": "tsx --env-file-if-exists=.env scripts/whoami.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "monitor": "tsx --env-file-if-exists=.env scripts/monitor.ts",
    "monitor:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/monitorctl.ps1 start",
    "monitor:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/monitorctl.ps1 stop",
    "monitor:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/monitorctl.ps1 restart",
    "monitor:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/monitorctl.ps1 status",
    "monitor:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/monitorctl.ps1 logs",
    "monitor:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-monitor-task.ps1",
    "monitor:autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-monitor-task.ps1 -Status",
    "monitor:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-monitor-task.ps1 -Remove",
    "invite:admin": "tsx --env-file-if-exists=.env scripts/invite.ts administrator --guild",
    "bot:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 start",
    "bot:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 stop",
    "bot:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 restart",
    "bot:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 status",
    "bot:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 logs",
    "bot:tail": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/botctl.ps1 tail",
    "bot:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-autostart-task.ps1",
    "bot:autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-autostart-task.ps1 -Status",
    "bot:autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-autostart-task.ps1 -Remove",
    "deploy:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1",
    "deploy:auto:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1 -Force",
    "deploy:auto:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1 -CheckOnly",
    "deploy:auto:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/deploy.ps1 -Status",
    "deploy:task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/register-deploy-task.ps1",
    "deploy:task:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/register-deploy-task.ps1 -Remove",
    "deploy:task:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy/register-deploy-task.ps1 -Status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
