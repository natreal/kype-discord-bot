{
  "name": "discord-bot-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation of a modular, production-quality Discord bot platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#/*": "./dist/*"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "npm run db:generate && tsc --build",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "deploy:commands": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "invite:admin": "tsx --env-file-if-exists=.env scripts/invite.ts administrator --guild"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  }
}
