# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem

# --- Dependencies ----------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# --- Build output ----------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# Generated Prisma Client (recreated with `npm run db:generate`)
src/generated/

# --- Tests -----------------------------------------------------------------
coverage/
.nyc_output/

# --- Tooling caches --------------------------------------------------------
.eslintcache
.vitest/
.cache/
.tmp/
.temp/

# --- Logs ------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Desktop launcher runtime state ----------------------------------------
# PID/lock files written by scripts/desktop/supervisor.sh, and the generated
# app bundle produced by `npm run desktop:app` (regenerate, do not commit).
.run/
*.app/

# --- Deployment artifacts --------------------------------------------------
# Database dumps written by scripts/deploy/deploy.ps1 before migrations, and the
# dependency tree kept for rollback. Neither belongs in git.
backups/
node_modules.__previous/

# --- Editors / IDEs --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Operating systems -----------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Vitest fixture directories (created by tests at runtime) ----------------
tests/.fixtures/
tests/.fs-fixtures/
