# ---------------------------------------------------------------------------
# Discord bot foundation - local configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application (client) ID from the General Information tab
DISCORD_CLIENT_ID=
# Optional: only set when you want instant command updates in a single guild.
# Leave empty to register globally (can take up to an hour to propagate).
DISCORD_DEV_GUILD_ID=

# --- Slash command registration --------------------------------------------
# Whether the bot publishes its slash commands on its own.
#
#   TRUE  (recommended for a bot on more than one server) -> commands are
#         registered automatically at startup and again the moment the bot
#         joins a server, and any server that is behind is repaired.
#   FALSE (the built-in default when this line is absent) -> commands are only
#         registered when you run `npm run deploy:commands`. This default is
#         deliberate: a bot that already exists should not start registering
#         commands just because it was upgraded. Set it to true to opt in.
#
# `/admin deploy` works either way.
COMMANDS_AUTO_DEPLOY=true

# Where commands are registered when they are deployed:
#   global        -> application-wide only (one API call, up to 1h propagation).
#                    THE DEFAULT, and the right choice for a distributed bot:
#                    each command is listed exactly once in every server.
#   global+guilds -> application-wide *and* per guild, so a server that just
#                    installed the bot works immediately instead of waiting up
#                    to an hour. Development convenience only: Discord keeps the
#                    two scopes separate and does not merge them, so every
#                    command then appears TWICE in every server's command list.
#   dev-guild     -> only DISCORD_DEV_GUILD_ID, for local development.
#
# This setting is authoritative: it is honoured even when DISCORD_DEV_GUILD_ID
# is set. Turning a development guild ID into the deployment target was a real
# bug, and is fixed: an explicit scope always wins.
#
# Switching away from `global+guilds` leaves its guild-scoped copies behind, where
# they keep doubling the global ones. Clear them with:
#   npm run deploy:clear-guilds
COMMANDS_DEPLOY_SCOPE=global

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_bot?schema=public

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- GitHub repository monitor (V9) ----------------------------------------
# Tracks a GitHub project's implementation statistics, commits and pull requests,
# stores one timestamped snapshot per refresh, and posts what changed to a channel.
#
# The statistics are read from the project's own published progress.json (produced
# by its CI from tools/progress.py), never recomputed by the bot, so the numbers
# always match the project's badges.
#
# Repository to watch, as owner/repository. Defaults to boykopovar/AnyPS5.
# GITHUB_REPOSITORY=boykopovar/AnyPS5
#
# Optional token. Without one the bot is limited to 60 requests/hour; with one,
# 5,000. A token with no scopes is enough: everything read is public.
# GITHUB_TOKEN=
#
# Minutes between refreshes (1-1440; default 15). The job is a durable
# scheduler task, so it survives restarts and never overlaps with itself.
# GITHUB_POLL_INTERVAL_MINUTES=15
#
# Channel for the report. Leave empty to keep the history (and `/github`)
# without posting anything.
# GITHUB_REPORT_CHANNEL_ID=

# --- AI (all optional; the bot runs fully without AI) ----------------------
# OpenAI-compatible base URL. Covers OpenAI, Azure, OpenRouter, Groq, Together,
# vLLM and local Ollama / LM Studio.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# Model tiers: `fast` for classification/summaries, `smart` for the assistant
# and the keyword agent.
# AI_MODEL_FAST=
# AI_MODEL_SMART=
# Hard daily token budget across all requests (0 = unlimited).
# AI_DAILY_TOKEN_BUDGET=0
# Per-request timeout in milliseconds.
# AI_REQUEST_TIMEOUT_MS=20000
# Default keyword that wakes the agent (a server may override it via `/ai trigger`).
# AI_DEFAULT_TRIGGER=kype
